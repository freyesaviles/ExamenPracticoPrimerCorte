@startuml
title Propuesta de arquitectura - Sistema del Test de Inteligencia de Weill

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam ArrowColor #37474F
skinparam packageBorderColor #455A64
skinparam componentBorderColor #455A64
skinparam linetype ortho
left to right direction

actor "Usuario\n(Psicólogo / Evaluador)" as Usuario

rectangle "Cliente" as Cliente {
  component "Aplicación web\nInterfaz para registrar y\nconsultar evaluaciones" as Web
}

rectangle "API REST - Spring Boot" as API {
  package "Capa de presentación" as Presentacion {
    component "ResultadoWeillController\n\nRecibe solicitudes HTTP\nValida el formato de entrada\nDevuelve códigos HTTP y JSON" as Controller
    component "DTOs y manejo de errores\n\nDefine datos de entrada/salida\ny respuestas de error" as DTO
  }

  package "Capa de aplicación" as Aplicacion {
    component "ResultadoWeillService\n\nCoordina los casos de uso:\nregistrar, listar, consultar,\nactualizar y eliminar resultados" as Service
  }

  package "Capa de lógica de negocio" as Negocio {
    component "Reglas del Test de Weill\n\nValida puntuaciones y estado\nDetermina o verifica el nivel\nBAJO, PROMEDIO o ALTO" as Reglas
    component "ResultadoWeill\nEntidad del dominio" as Entidad
  }

  package "Capa de acceso a datos" as Datos {
    component "ResultadoWeillRepository\n(Spring Data JPA)\n\nGuarda y recupera evaluaciones" as Repository
  }

  package "Capa de infraestructura" as Infraestructura {
    component "Hibernate / JPA\nMapeo objeto-relacional" as JPA
    component "Driver JDBC\nConexión con PostgreSQL" as JDBC
    component "Configuración y seguridad\nCORS, validación y manejo\nglobal de excepciones" as Config
  }
}

database "PostgreSQL\n\nTabla: resultados_weill\nPersistencia de evaluaciones" as PostgreSQL

Usuario --> Web : Utiliza
Web <-[#1565C0]-> Controller : HTTPS + JSON\nSolicitud / respuesta
Controller ..> DTO : Valida y transforma
Controller <-[#1565C0]-> Service : Invoca caso de uso /\nrecibe DTO de respuesta
Service --> Reglas : Aplica reglas
Reglas --> Entidad : Crea o modifica
Service <-[#1565C0]-> Repository : Guarda o consulta /\nrecibe entidades
Repository <-[#1565C0]-> JPA : Operación JPA /\nresultado
JPA <-[#1565C0]-> JDBC : SQL / datos
JDBC <-[#1565C0]-> PostgreSQL : TCP/IP + protocolo\nPostgreSQL

Config ..> Controller : configuración transversal
Config ..> Service : manejo de errores

note bottom of Web
  Cliente consumidor de la API.
  No accede directamente a la base de datos.
end note

note bottom of API
  Solicitud: Cliente -> Controller -> Service -> Reglas -> Repository -> PostgreSQL
  Respuesta: PostgreSQL -> Repository -> Service -> Controller -> JSON -> Cliente
end note

@enduml
